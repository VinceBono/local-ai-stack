# Copy to .env and change what you need. Every line is optional.

# Model downloaded on first start. Any tag from https://ollama.com/library
MODEL=llama3.2:3b

# Where the web page listens. 127.0.0.1 = this machine only.
BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000

# To always include the GPU file, so plain "docker compose up -d" uses it
# (use ; instead of : on Windows):
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Only used with compose.vllm.yaml
# VLLM_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
# HF_TOKEN=
